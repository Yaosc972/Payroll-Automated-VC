{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "env": {
    "SIGMA_WORKBENCH_HOME": "/tmp/sigma-workbench",
    "SIGMA_WORKBENCH_SEED_DIR": "outputs",
    "SIGMA_HIDE_DEVELOPING_MODULES": "1",
    "SIGMA_OVERSEAS_LABOR_ACCESS": "uat_full",
    "SIGMA_OVERSEAS_LABOR_UAT_ROLES": "Payroll Admin,Compensation UAT"
  }
}
