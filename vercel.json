{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "SIGMA_WORKBENCH_HOME": "/tmp/sigma-workbench",
    "SIGMA_WORKBENCH_SEED_DIR": "outputs",
    "SIGMA_HIDE_DEVELOPING_MODULES": "1",
    "SIGMA_LABOR_STORAGE_BACKEND": "blob",
    "SIGMA_LABOR_BLOB_ENV": "uat",
    "SIGMA_OVERSEAS_LABOR_ACCESS": "uat",
    "SIGMA_OVERSEAS_LABOR_UAT_ROLES": "Payroll Admin,Compensation UAT"
  }
}
