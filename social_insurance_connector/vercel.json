{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/subjects", "destination": "/api/subjects" },
    { "source": "/sync", "destination": "/api/sync" }
  ]
}
