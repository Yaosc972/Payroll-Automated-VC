AI_ENABLED=true
AI_PROVIDER=mimo
MIMO_API_KEY=replace-with-your-mimo-token
# Overseas labor production processing is local-OCR only. External AI requires a separate approved decision.
SIGMA_LABOR_EXTERNAL_AI_ENABLED=false
# Formal labor browser mutations always enforce the page/API build contract in code.
# Leave the legacy SIGMA_LABOR_REQUIRE_CLIENT_CONTRACT setting unset; it cannot disable the guard.
# Optional defaults for MiMo:
# AI_BASE_URL=https://api.xiaomimimo.com/v1
# AI_MODEL=mimo-v2.5
# AI_MAX_PAGES_PER_REQUEST=1
# AI_TIMEOUT_SECONDS=180
# AI_RENDER_SCALE=1.5
# AI_IMAGE_RETRY_DELAYS=2
# AI_RETRY_EMPTY_PAGE_CACHE=true
# Optional future OCR/layout toolchain. Keep empty until installed and tested:
# AI_DOCUMENT_TOOLCHAIN=pypdfium2,mimo
# AI_OCR_COMMAND="/path/to/worker-python" "/path/to/tools/labor_ocr_worker_task.py"
# LABOR_OCR_CACHE_DIR=/path/to/local/overseas-labor-ocr-cache
# LABOR_AUDIT_PATH=/path/to/local/overseas-labor-audit/events.jsonl
# LABOR_RUN_RETENTION_DAYS=90
# LABOR_OCR_CACHE_RETENTION_DAYS=30
# LABOR_OCR_CACHE_MAX_BYTES=5368709120
# LABOR_MAX_PDF_BYTES=52428800
# LABOR_MAX_WORKBOOK_BYTES=20971520
# LABOR_MAX_PDF_FILES=30
# LABOR_MAX_WORKBOOK_FILES=10
# LABOR_MAX_PDF_PAGES=300
# LABOR_MAX_ACTIVE_TASKS_PER_OWNER=1
# LABOR_MAX_ACTIVE_TASKS_GLOBAL=2

# Admin permission store.
# Local default uses outputs/sigma_workbench.db. For Supabase/Vercel, set the pooled Postgres URL:
# ADMIN_DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Comma-separated user id/name/email/open_id/union_id values that should always keep system admin.
# ADMIN_BOOTSTRAP_IDENTIFIERS=姚硕灿
# Permission notification cards. The open_id must belong to the same Feishu app.
# FEISHU_PERMISSION_ADMIN_OPEN_ID=ou_xxx
# Feedback cards resolve one active system administrator by exact platform display name.
# FEISHU_FEEDBACK_ADMIN_NAME=姚硕灿
# SIGMA_WORKBENCH_PUBLIC_URL=https://sigma-workbench.vercel.app

# Overseas labor production infrastructure. Enable these as one reviewed set;
# never copy example credentials into a real environment.
# SIGMA_OVERSEAS_LABOR_ACCESS=production
# SIGMA_LABOR_P1_REQUIRED=true
# SIGMA_LABOR_AUTH_REQUIRED=true
# SIGMA_ENABLE_MOCK_LOGIN=false
# SESSION_COOKIE_SECURE=true
# FEISHU_APP_ID=replace-with-feishu-app-id
# FEISHU_APP_SECRET=replace-with-feishu-app-secret
# FEISHU_REDIRECT_URI=https://sigma-workbench.example.com/api/auth/feishu/callback
# ADMIN_DATABASE_URL=postgresql://user:password@host/database
# SIGMA_LABOR_STATE_BACKEND=postgres
# SIGMA_LABOR_DATABASE_URL=postgresql://user:password@host/database
# SIGMA_LABOR_EXECUTION_MODE=personal-worker
# SIGMA_LABOR_JOB_BACKEND=postgres
# The queue reuses SIGMA_LABOR_DATABASE_URL by default. Only set this override
# after reviewing the loss of the same-database foreign-key boundary.
# SIGMA_LABOR_JOB_DATABASE_URL=postgresql://user:password@other-host/database
# SIGMA_LABOR_WORKER_LEASE_SECONDS=120
# SIGMA_LABOR_WORKER_TOKEN_TTL_SECONDS=28800
# SIGMA_LABOR_REQUIRED_WORKER_VERSION=0.3.11
# SIGMA_LABOR_PUBLIC_URL=https://sigma-workbench.example.com

# Direct private upload/download requires a private Supabase bucket.
# Vercel Blob remains a legacy persistence adapter and does not satisfy this gate.
# SIGMA_LABOR_STORAGE_BACKEND=supabase
# SIGMA_LABOR_STORAGE_ENV=production
# SUPABASE_URL=https://project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# SIGMA_LABOR_SUPABASE_BUCKET=sigma-labor-runs

# Static Worker tokens are only for local compatibility tests when P1 is off.
# SIGMA_LABOR_WORKER_TOKENS={"replace-with-random-token":{"userId":"user-123","deviceId":"device-abc"}}
# Protects /api/labor/operations and /api/labor/worker/health.
# SIGMA_LABOR_OPERATIONS_TOKEN=replace-with-random-admin-token
# Optional signed release metadata. Worker checks this at startup/idle and after a task.
# SIGMA_LABOR_WORKER_UPDATE_MANIFEST={"version":"0.2.6","url":"https://downloads.example.com/sigma-workbench-0.2.6.dmg","sha256":"...","signature":"...","minimumVersion":"0.2.5"}
# LABOR_MINIMUM_FREE_BYTES=2147483648
# Optional supplier-specific extraction profiles:
# LABOR_SUPPLIER_PROFILES_PATH=docs/labor_supplier_profiles.example.json

# Feishu enterprise SSO / OAuth. Keep secrets only in local/server env, never commit real values.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8000/api/auth/feishu/callback
FEISHU_AUTH_URL=https://open.feishu.cn/open-apis/authen/v1/index
SESSION_COOKIE_SECURE=false

# FBU production persistence. Apply the matching Supabase migration before
# changing SIGMA_FBU_STATE_BACKEND to postgres. Storage remains the file/rollback layer.
# SIGMA_FBU_STORAGE_BACKEND=supabase
# SIGMA_FBU_STATE_BACKEND=postgres
# SIGMA_FBU_STORAGE_ENV=production
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# SIGMA_FBU_SUPABASE_BUCKET=sigma-labor-runs

# P0 UAT keeps approved supplier Profiles inside the release bundle at
# data/supplier_profiles; leave path overrides unset so version drift is detectable.

# Social-insurance reporting MVP. Credentials stay in macOS Keychain under
# beisen-social-insurance-key / beisen-social-insurance-secret; never put them here.
# SIGMA_SOCIAL_INSURANCE_RUNS_DIR=/path/to/private/social-insurance-runs
# SIGMA_SOCIAL_INSURANCE_BASELINES_DIR=/path/to/private/social-insurance-baselines
# SIGMA_SOCIAL_INSURANCE_ENGINE_DIR=/path/to/validated/social-insurance-beisen-engine
# SIGMA_SOCIAL_INSURANCE_NODE=/path/to/bundled/node
# SIGMA_SOCIAL_INSURANCE_TEMPLATE_FILE=/path/to/current/shenzhen-government-template.xls
# Until the Beisen connector exposes the voluntary-stop field, the validated
# departure-rule snapshot must be refreshed and explicitly configured for UAT.
# SIGMA_SOCIAL_INSURANCE_DIMISSION_FILE=/path/to/current/departure-snapshot.xlsx
# One-time historical replay only: point to the original Beisen monthly roster.
# The platform captures a private immutable baseline for that period and subject;
# normal monthly use should leave this unset after the baseline is established.
# SIGMA_SOCIAL_INSURANCE_BASELINE_SOURCE_FILE=/path/to/original-beisen-monthly-roster.xlsx
# 已配置真实北森引擎时默认启用候选池后台预热；可显式关闭。
# SIGMA_SOCIAL_INSURANCE_PREFETCH_ENABLED=true
# SIGMA_SOCIAL_INSURANCE_PREFETCH_INTERVAL_MINUTES=120
# 前台同步完成后至少空闲 5 分钟再预热，避免后台全量查询抢占业务操作。
# SIGMA_SOCIAL_INSURANCE_PREFETCH_INTERACTIVE_DELAY_SECONDS=0
# 默认先完成页面合同主体加载，再异步准备候选池；仅需强制启动预热时设置秒数。
# SIGMA_SOCIAL_INSURANCE_PREFETCH_STARTUP_DELAY_SECONDS=7200
# SIGMA_SOCIAL_INSURANCE_SUBJECT_CACHE_SECONDS=10800
# SIGMA_SOCIAL_INSURANCE_POOL_CACHE_SECONDS=14400
