AI_ENABLED=true
AI_PROVIDER=mimo
MIMO_API_KEY=replace-with-your-mimo-token
# Optional defaults for MiMo:
# AI_BASE_URL=https://api.xiaomimimo.com/v1
# AI_MODEL=mimo-v2.5
# AI_MAX_PAGES_PER_REQUEST=1
# AI_TIMEOUT_SECONDS=180
# AI_RENDER_SCALE=1.5
# Optional future OCR/layout toolchain. Keep empty until installed and tested:
# AI_DOCUMENT_TOOLCHAIN=pypdfium2,mimo
# AI_OCR_COMMAND=
# Optional supplier-specific extraction profiles:
# LABOR_SUPPLIER_PROFILES_PATH=docs/labor_supplier_profiles.example.json

# Admin permission store — 支持 SQLite / Postgres / MySQL 三种后端。
# 本地默认使用 outputs/sigma_workbench.db。
# Postgres (Vercel / Supabase Pooler):
# ADMIN_DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# MySQL 8.x:
# ADMIN_DATABASE_URL=mysql://root:password@127.0.0.1:3306/sigma_workbench
# Comma-separated user id/name/email/open_id/union_id values that should always keep system admin.
# ADMIN_BOOTSTRAP_IDENTIFIERS=姚硕灿

# Overseas labor production storage and worker queue.
# SIGMA_OVERSEAS_LABOR_ACCESS=production
# Storage backends: "supabase" | "obs" | "blob"
# SIGMA_LABOR_STORAGE_BACKEND=obs
# SIGMA_LABOR_STORAGE_ENV=production
# Supabase storage (legacy)
# SIGMA_LABOR_SUPABASE_BUCKET=sigma-labor-runs
# OBS (Huawei Cloud Object Storage) — S3-compatible
# OBS_ACCESS_KEY=replace-with-your-ak
# OBS_SECRET_KEY=replace-with-your-sk
# OBS_ENDPOINT=obs.cn-south-1.myhuaweicloud.com
# OBS_BUCKET=sigma-labor-runs
# SIGMA_LABOR_EXECUTION_MODE=worker
# SIGMA_LABOR_JOB_BACKEND=mysql     # 劳务任务队列后端: postgres | mysql
# SIGMA_LABOR_JOB_DATABASE_URL=mysql://root:password@127.0.0.1:3306/sigma_workbench
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# HRAS 壳子平台子应用注册配置（本地开发默认关闭，生产环境按需开启）
# HRAS_SHELL_URL=http://localhost:8066
# HRAS_SHELL_REGISTER_ENABLED=true
# HRAS_MODULE_KEY=hras-payroll
# HRAS_MODULE_NAME=薪酬核算平台
# HRAS_MODULE_FRONTEND_URL=http://localhost:8000
# HRAS_MODULE_BACKEND_URL=http://localhost:8000
# HRAS_MODULE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # 由壳子管理员创建模块标识后提供

# HRAS 壳子 JWT 验证密钥（用于壳子内自动登录，联系壳子管理员获取）
# HRAS_JWT_SECRET=hras-shell-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256

# Feishu enterprise SSO / OAuth. Keep secrets only in local/server env, never commit real values.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8000/api/auth/feishu/callback
FEISHU_AUTH_URL=https://open.feishu.cn/open-apis/authen/v1/index
SESSION_COOKIE_SECURE=false
