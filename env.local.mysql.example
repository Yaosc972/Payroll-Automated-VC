# Local single-machine profile. Copy to .env.local.mysql and replace
# placeholders; never commit the copied file.
SIGMA_MYSQL_TIME_ZONE=+08:00

# The local profile uses the MySQL instance on this computer. The default
# database name and port are deliberately different from any company server.
# The app also accepts the AIDeploy/company-server split variables:
# Keep this URL for the local profile; replace the password locally.
ADMIN_DATABASE_URL=mysql+pymysql://sigma_app:replace-with-local-password@127.0.0.1:3307/sigma_workbench_local?charset=utf8mb4
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_USER=sigma_app
# MYSQL_DATABASE=sigma_workbench_local
# MYSQL_PASSWORD=replace-with-local-password

# Business files stay on the local data root in this profile. Do not set any
# Supabase/Vercel storage variables for local operation.
SIGMA_WORKBENCH_HOME=/absolute/path/to/sigma-workbench-local-data
SIGMA_LABOR_STATE_BACKEND=local
SIGMA_LABOR_JOB_BACKEND=local-json
SIGMA_FBU_STATE_BACKEND=off
# Leave SIGMA_LABOR_STORAGE_BACKEND, SIGMA_FBU_STORAGE_BACKEND,
# SIGMA_DOMESTIC_LABOR_STORAGE_BACKEND and
# SIGMA_SOCIAL_INSURANCE_STORAGE_BACKEND unset for local files.

# Local Beisen mode: leave the remote connector URL/token empty and point this
# at the bundled social_insurance_connector directory. It reads live Beisen
# employment records during the local scheduled sync; no monthly departure
# workbook is required. A legacy mvp.mjs engine may still use the fallback file.
# SIGMA_SOCIAL_INSURANCE_ENGINE_DIR=/absolute/path/to/project/social_insurance_connector
# SIGMA_SOCIAL_INSURANCE_NODE=/absolute/path/to/node
# SIGMA_SOCIAL_INSURANCE_TEMPLATE_FILE=/absolute/path/to/government-template.xlsx

# Local Feishu callback. A production/company-server callback must be a
# separate registered HTTPS URL.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8001/api/auth/feishu/callback
SESSION_COOKIE_SECURE=false
